# Prototype configuration. Copy to .env for local runs; never commit .env.
KILOOS_ENV=dev
KILOOS_DB=var/kiloos.db
KILOOS_EVIDENCE_DIR=var/evidence
# Required outside dev: at least 32 random characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KILOOS_SECRET=dev-only-change-me
