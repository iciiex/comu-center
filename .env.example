# Prototype configuration. Copy to .env for local runs; never commit .env.
KILOOS_ENV=dev
KILOOS_DB=var/kiloos.db
KILOOS_EVIDENCE_DIR=var/evidence
# Required outside dev: at least 32 random characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KILOOS_SECRET=dev-only-change-me

# Default: neither demo exposes a login. Set play OR legacy only on a synthetic-data host.
KILOOS_DEMO_MODE=off
# Required for either demo mode: a separate random 32+ character operator credential.
# Use the generator above; do not put it in a URL, log, or a tracked file.
KILOOS_DEMO_OPERATOR_KEY=
