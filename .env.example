# Copy to `.env` for local development. NEVER commit a real `.env`.
# All values below are placeholders / safe local defaults — no real secrets.

# local | test | production  (production enforces stricter validation)
INVAR_ENV=local

# Comma-separated product scopes this deployment may serve. First pilot: damiish.
INVAR_ENABLED_PRODUCTS=damiish

# Master kill-switches. AI sending and live Meta sending are OFF by default.
INVAR_AI_SEND_ENABLED=false
INVAR_META_LIVE_SEND_ENABLED=false

# Database (PostgreSQL: production target, adapter pending / Docker Compose)
INVAR_DATABASE_URL=postgresql://invar:CHANGE_ME_LOCAL_ONLY@localhost:5432/invar_comms

# Local SQLite store (dev/tests only — see ADR-0008; initialize: python -m invar_comms db-init)
INVAR_SQLITE_PATH=data/invar_comms.sqlite3

# Meta / Instagram (leave empty until an approved test app exists — see docs/integrations/meta-instagram.md)
INVAR_META_APP_SECRET=
INVAR_META_WEBHOOK_VERIFY_TOKEN=
INVAR_META_ACCESS_TOKEN=

# Chatwoot (Agent Bot integration, ADR-0007 — leave empty until the live spike)
INVAR_CHATWOOT_BASE_URL=
INVAR_CHATWOOT_BOT_TOKEN=
INVAR_CHATWOOT_WEBHOOK_SECRET=
# Inbox -> product mapping, e.g. 7=damiish:instagram:ig-acct-1
INVAR_CHATWOOT_INBOX_MAP=

# HTTP adapter (python -m invar_comms serve) — bind 0.0.0.0 only behind TLS/a proxy
INVAR_HTTP_HOST=127.0.0.1
INVAR_HTTP_PORT=8000

# AI provider: "fake" (default, deterministic) or "openai_compat" for any
# OpenAI-compatible endpoint — free options: Gemini AI Studio free tier
# (https://generativelanguage.googleapis.com/v1beta/openai), Groq free tier
# (https://api.groq.com/openai/v1), or local Ollama (http://localhost:11434/v1,
# no key). See docs/operations/instagram-ai-setup-fa.md
INVAR_AI_PROVIDER_NAME=fake
INVAR_AI_PROVIDER_API_KEY=
INVAR_AI_API_BASE_URL=
INVAR_AI_MODEL=

# Direct Meta/Instagram (official Graph API; ADR-0010). Map your IG account id
# to a product, e.g. 17841400008460056=damiish
INVAR_META_ACCOUNT_MAP=
INVAR_META_IG_ACCOUNT_ID=
INVAR_META_GRAPH_BASE_URL=https://graph.instagram.com
INVAR_META_API_VERSION=v25.0

# Operator inbox API token (GET /api/conversations with X-Operator-Token)
INVAR_OPERATOR_TOKEN=
